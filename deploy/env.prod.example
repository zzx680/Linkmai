# LinkMai production environment (template).
#
#   node deploy/scripts/generate-secrets.mjs
#
# writes deploy/.env.prod from this file, replacing every generated placeholder
# with a fresh random value and chmod 600. Fill in the CHANGE_ME values before
# the first start. Never commit the generated .env.prod.

# --- Images ---------------------------------------------------------------
# Build locally with `./deploy/scripts/compose.sh build`, or push these tags to
# ACR and pull them on ECS. The default repository is the local Docker name.
LINKMAI_IMAGE_REPO=linkmai
LINKMAI_IMAGE_TAG=prod
LINKMAI_VERSION=linkmai
GIT_SHA=

# --- Public URLs ----------------------------------------------------------
# Production validation rejects http:// for all three. The apex serves the
# official site and the signed-in workspace; the mini-program is being retired.
FRONTEND_URL=https://linkmai.com
API_PUBLIC_URL=https://linkmai.com/api
WORD_ADDIN_URL=https://word.linkmai.com

# Baked into the frontend image at build time. Rebuild the frontend after
# changing any of them.
LINKMAI_SITE_URL=https://linkmai.com
LINKMAI_SUPPORT_EMAIL=support@linkmai.com
LINKMAI_TERMS_URL=
LINKMAI_PRIVACY_URL=

# Extra browser origins allowed by the backend, comma-separated. The public
# app and Word origins are already allowed through FRONTEND_URL/WORD_ADDIN_URL.
ALLOWED_ORIGINS=

# --- PostgreSQL -----------------------------------------------------------
# Default: the compose file runs supabase/postgres on a named volume. The
# postgres superuser runs schema.sql/migrations; service_role has BYPASSRLS.
# No RDS instance is required. Set a strong password for the postgres role.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# Login roles used by GoTrue/PostgREST inside the private Docker network.
# generate-secrets.mjs fills the two passwords and the two JWTs below.
SUPABASE_AUTH_ADMIN_PASSWORD=__AUTH_ADMIN_PASSWORD__
AUTHENTICATOR_PASSWORD=__AUTHENTICATOR_PASSWORD__

# GoTrue and PostgREST share this HS256 secret. The two JWTs below are signed
# with it; generate-secrets.mjs creates all three together.
GOTRUE_JWT_SECRET=__JWT_SECRET__
SUPABASE_PUBLISHABLE_KEY=__ANON_KEY__
SUPABASE_SECRET_KEY=__SERVICE_KEY__

# --- Alibaba Cloud OSS ----------------------------------------------------
# Private bucket. The browser must use OSS_PUBLIC_ENDPOINT (the custom domain
# mapped to the bucket); the default *.aliyuncs.com endpoint is rejected for
# new mainland buckets. The backend uses the internal endpoint.
OSS_BUCKET_NAME=linkmai-prod
OSS_REGION=cn-hangzhou
OSS_INTERNAL=true
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://storage.linkmai.com
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=__REDIS_PASSWORD__

# --- Application secrets --------------------------------------------------
# Production refuses to start without these. They are independent: rotating
# one does not invalidate the others.
DOWNLOAD_SIGNING_SECRET=__DOWNLOAD_SECRET__
USER_API_KEYS_ENCRYPTION_SECRET=__USER_KEYS_SECRET__
AUTH_HANDOFF_ENCRYPTION_SECRET=__AUTH_HANDOFF_SECRET__

# --- Email (Supabase Auth) ------------------------------------------------
# Alibaba Cloud DirectMail, or any SMTP provider. The From address must be a
# verified sender. Use 587 for STARTTLS; 465 is the implicit-TLS fallback.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@linkmai.com
SMTP_SENDER_NAME="灵迈 LinkMai"

# Phone sign-in. GoTrue creates and checks the OTP; the backend's Send SMS
# hook delivers it through Aliyun Dysmsapi. Fill the four ALIYUN_SMS_* values
# and set SEND_SMS_HOOK_ENABLED=true before enabling the phone button.
PHONE_SIGNIN_ENABLED=true
SEND_SMS_HOOK_ENABLED=false
SEND_SMS_HOOK_URI=https://linkmai.com/api/auth/hooks/send-sms
SEND_SMS_HOOK_SECRET=__SEND_SMS_HOOK_SECRET__
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=灵迈LinkMai
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou

# Closed-beta invite-code sign-in. Comma-separated; each code is one stable
# workspace credential. Replace the generated placeholder with the codes you
# hand to testers.
LINKMAI_INVITE_CODES=__INVITE_CODES__

# WeChat Open Platform website application. Leave the app id/secret empty to
# hide the WeChat button; the callback must be registered verbatim.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://linkmai.com/api/auth/wechat/callback
WECHAT_STATE_SECRET=__WECHAT_STATE_SECRET__

# --- Models ---------------------------------------------------------------
# DeepSeek official API (OpenAI-compatible).
# Create an API key at https://platform.deepseek.com/ and set DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_SEARCH_API_KEY=
LINKMAI_MODEL_CONFIG_JSON='{"models":[{"id":"deepseek-v4-pro","label":"DeepSeek V4 Pro","provider":"openai-compatible","location":"cloud","baseUrl":"https://api.deepseek.com/v1","apiModel":"deepseek-v4-pro","apiKeyEnv":"DEEPSEEK_API_KEY"},{"id":"deepseek-flash","label":"DeepSeek Flash","provider":"openai-compatible","location":"cloud","baseUrl":"https://api.deepseek.com/v1","apiModel":"deepseek-flash","apiKeyEnv":"DEEPSEEK_API_KEY"}]}'
# Deployment defaults: what a surface starts on before the user picks a model.
# A saved chat or profile choice always wins, and a default this account cannot
# use (unconfigured model, no organization key, outside its router selection)
# is skipped, never persisted. Unset means the surface keeps its own fallback.
LINKMAI_DEFAULT_CHAT_MODEL=deepseek-v4-pro
LINKMAI_DEFAULT_TITLE_MODEL=deepseek-flash
LINKMAI_DEFAULT_MEMORY_MODEL=deepseek-flash
LINKMAI_DEFAULT_TABULAR_MODEL=deepseek-flash
LINKMAI_DEFAULT_SUBAGENT_MODEL=deepseek-v4-pro

# --- Sign-up and Google ---------------------------------------------------
# Keep sign-up closed if this is an invite-only legal workspace.
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# --- Error reporting ------------------------------------------------------
# Off by default. If enabled, use a Sentry project with the shared 50
# events/day ceiling.
SENTRY_DSN=
SENTRY_DISABLED=true
