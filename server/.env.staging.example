PORT=8100
HOST=127.0.0.1
NODE_ENV=staging
CORS_ORIGINS=https://servicewechat.com

DB_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=linkmai_staging
POSTGRES_PASSWORD=
POSTGRES_DB=linkmai_staging
POSTGRES_SSL=false
# 远程 RDS 时改为 true，并设置 POSTGRES_SSL_CA_FILE
# POSTGRES_SSL_CA_FILE=/etc/linkmai/secrets/rds-ca.pem

WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALLOW_MOCK_WECHAT_LOGIN=false

JWT_SECRET=

ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=

ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

PAYMENT_AMOUNT_CENTS=1
PAYMENT_CURRENCY=CNY
PAYMENT_ORDER_EXPIRES_MINUTES=15
PAYMENT_PROVIDER=disabled

WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY_FILE=/etc/linkmai/secrets/apiclient_key.pem
WECHAT_API_V3_KEY_FILE=/etc/linkmai/secrets/wechat_api_v3_key
WECHAT_PAY_PUBLIC_KEY_FILE=/etc/linkmai/secrets/wechatpay_public_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://staging-api.example.com/api/payments/wechat/notify
