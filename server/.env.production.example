PORT=8200
HOST=127.0.0.1
NODE_ENV=production
CORS_ORIGINS=https://servicewechat.com

DB_TYPE=postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=linkmai_production
POSTGRES_PASSWORD=
POSTGRES_DB=linkmai_production
POSTGRES_SSL=true
POSTGRES_SSL_CA_FILE=/etc/linkmai/secrets/rds-ca.pem

WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALLOW_MOCK_WECHAT_LOGIN=false

JWT_SECRET=

# 审核工作流：真实值仅保存于服务器环境文件或密钥管理系统。
HARNESS_ENABLED=false
REVIEW_JWT_SECRET=

ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=

ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com

DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

PAYMENT_AMOUNT_CENTS=4990
PAYMENT_CURRENCY=CNY
PAYMENT_ORDER_EXPIRES_MINUTES=15
PAYMENT_PROVIDER=wechat

WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY_FILE=/etc/linkmai/secrets/apiclient_key.pem
WECHAT_API_V3_KEY_FILE=/etc/linkmai/secrets/wechat_api_v3_key
WECHAT_PAY_PUBLIC_KEY_FILE=/etc/linkmai/secrets/wechatpay_public_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://PRODUCTION_API_DOMAIN/api/payments/wechat/notify
