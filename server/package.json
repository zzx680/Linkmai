{
  "name": "linkmai-server",
  "type": "module",
  "version": "1.0.0",
  "description": "Linkmai traffic accident assistant backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/scripts/init-db.ts",
    "db:test": "node scripts/test-db.js",
