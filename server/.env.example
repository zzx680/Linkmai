# 服务器配置
PORT=8000
NODE_ENV=development

# 数据库配置（内存或 PostgreSQL）
# 开发环境可以用 memory，生产环境必须用 postgres
DB_TYPE=memory
# DB_TYPE=postgres

# PostgreSQL 配置（仅当 DB_TYPE=postgres 时需要）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=linkmai
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_DB=linkmai
# POSTGRES_SSL=false

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# JWT 配置
JWT_SECRET=your_jwt_secret_here_change_in_production

# 阿里云 OSS 配置
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_OSS_BUCKET=your_bucket_name

# 阿里云 OCR 配置
ALIYUN_OCR_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OCR_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_OCR_ENDPOINT=ocr.cn-shanghai.aliyuncs.com

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com

# 案件一次性买断（价格仅由服务端配置决定）
PAYMENT_AMOUNT_CENTS=4990
PAYMENT_CURRENCY=CNY
PAYMENT_ORDER_EXPIRES_MINUTES=15
# mock 仅用于本地创建待支付订单；生产必须设为 wechat
PAYMENT_PROVIDER=mock

# 微信支付 API v3（生产环境必填）
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
