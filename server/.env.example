# 服务器配置
PORT=8000
NODE_ENV=development

# 数据库配置（内存或 PostgreSQL）
# 开发环境可以用 memory，生产环境必须用 postgres
DB_TYPE=memory
# DB_TYPE=postgres

# PostgreSQL 配置（仅当 DB_TYPE=postgres 时需要）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=linkmai
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_DB=linkmai
# POSTGRES_SSL=false

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# JWT 配置
JWT_SECRET=your_jwt_secret_here_change_in_production

# 阿里云 OSS 配置
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_OSS_BUCKET=your_bucket_name

# 阿里云 OCR 配置
ALIYUN_OCR_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OCR_ACCESS_KEY_SECRET=your_access_key_secret

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
